apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: openbao-pki-{{ app_domain_slug }}
  labels:
    app.kubernetes.io/managed-by: app-deploy
    app.kubernetes.io/name: {{ app_domain_slug }}
spec:
  vault:
    server: "{{ openbao_address }}"
    path: "{{ openbao_pki_int_mount }}/sign/dedicated-{{ app_domain_slug }}"
    caBundle: "{{ _ca_bundle | default('') }}"
    auth:
      appRole:
        path: approle
        roleId: "{{ cert_manager_role_id }}"
        secretRef:
          name: cert-manager-approle
          key: secret_id
