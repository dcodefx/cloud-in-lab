apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: allow-metrics-server-kubelet
spec:
  description: "metrics-server (kube-system) -> kubelet :10250 egress (kubelet metrikleri icin)"
  endpointSelector:
    matchLabels:
      k8s:k8s-app: metrics-server
  egress:
  - toEntities:
    - host
    - remote-node
    toPorts:
    - ports:
      - port: "10250"
        protocol: TCP
---
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: allow-metrics-server-apiserver
spec:
  description: "kube-apiserver -> metrics-server :443 ingress (aggregated API metrics)"
  endpointSelector:
    matchLabels:
      k8s:k8s-app: metrics-server
  ingress:
  - fromEntities:
    - kube-apiserver
    - host
    - remote-node
    toPorts:
    - ports:
      - port: "10250"
        protocol: TCP
---
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: allow-apiserver-metrics-egress
spec:
  description: "kube-apiserver -> metrics-server :10250 egress (aggregated API metrics)"
  endpointSelector:
    matchLabels:
      k8s:component: kube-apiserver
  egress:
  - toEndpoints:
    - matchLabels:
        k8s:k8s-app: metrics-server
    toPorts:
    - ports:
      - port: "10250"
        protocol: TCP
