[Unit]
Description={{ maintenance.project_name }} backup timer: {{ item.key }}

[Timer]
# OnCalendar: deklaratif zamanlama ifadesi (defaults/main.yml).
# İfade doğrudan systemd'ye gider: gün/ay/hafta/yıl, artık yıl, DST — hepsi onun.
