# Cilium inter-node health checker izni.
# Cluster health 1/3 reachable idi (session-069): reserved:health endpoint'i
# (artificial health endpoint, port 4240) policy kapsamina giriyor; default-deny-all
# altinda cross-node probe (kaynak remote-node/host) ingress'te reddediliyordu.
# Resmi fix (issue #14871): toPorts kullanilmaz; entity-only izin TCP 4240 + ICMP
# dahil tum protokolleri kapsar. Izinli kimlikler yalniz node altyapisi.
apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: allow-cilium-health
spec:
  description: "Cilium cluster health checker: reserved:health endpoint'ine cross-node entity izni"
  endpointSelector:
    matchLabels:
      "reserved:health": ""
  ingress:
  - fromEntities:
    - remote-node
    - host
    - health
  egress:
  - toEntities:
    - remote-node
    - host
    - health