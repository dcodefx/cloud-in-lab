{{ '#' }} autogenerated by roles/maintenance — DO NOT EDIT
[Unit]
Description={{ maintenance.project_name }} backup: {{ item.key }}
Wants=network-online.target
After=network-online.target
OnFailure={{ m_prefix }}-alert@%n.service

[Service]
Type=oneshot
# systemd system servisinde User= verilmedikçe $HOME set edilmez; script'ler
# set -u altında ${HOME}/bin/* yedek aramasında kırılıyordu (backup-etcd.sh:72).
# Değer deploy kullanıcısından turetilir (m_home): ubuntu → /home/ubuntu, root → /root.
Environment=HOME={{ m_home }}
{% if item.value.restic is defined and item.value.restic %}
EnvironmentFile={{ m_conf }}/backup/{{ item.key }}.env
# Restic parolası + Garage anahtarları: düz metin .env'de DEĞİL, systemd
# credential'ında şifreli. Açılışta çözülür ve $CREDENTIALS_DIRECTORY/
# {{ item.key }}-secrets olarak ramfs'te 0400 sunulur; script oradan
# source eder (bkz. maintenance/_common.sh → load_credential).
LoadCredentialEncrypted={{ item.key }}-secrets:{{ m_conf }}/backup/{{ item.key }}.secrets.conf
{% endif %}
ExecStart={{ m_root }}/maintenance/{{ item.value.script }}{{ ' ' ~ item.value.args if item.value.args is defined else '' }}
Nice=10
# No overlap: systemd skips the new trigger while the previous run is active (native)
