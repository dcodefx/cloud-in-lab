apiVersion: v1
kind: Config
current-context: viewer
clusters:
- cluster:
    certificate-authority-data: <BASE64_CERT_DATA>
    server: https://<KUBERNETES_HOST>:6443
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    user: viewer
  name: viewer
users:
- name: viewer
  user:
    token: <SERVICE_ACCOUNT_TOKEN>
