[Unit]
Description=OpenBao Secret Management
Documentation=https://openbao.org/docs/
After=network-online.target
Wants=network-online.target

[Service]
User={{ openbao_user }}
Group={{ openbao_group }}
ExecStart={{ openbao_bin }} server -config={{ openbao_config_dir }}/config.hcl
ExecReload=/bin/kill -HUP $MAINPID
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
{% if openbao_autounseal_enabled | default(false) %}
# Auto-Unseal PKCS#11 / SoftHSM2 için ek erişim
ReadWritePaths={{ openbao_home }} /var/log/bao {{ openbao_plugin_dir }}
ReadOnlyPaths={{ openbao_softhsm_token_dir | default('/var/lib/softhsm/tokens') }}
SupplementaryGroups={{ openbao_softhsm_group | default('softhsm') }}
{% else %}
ReadWritePaths={{ openbao_home }} /var/log/bao
{% endif %}
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
