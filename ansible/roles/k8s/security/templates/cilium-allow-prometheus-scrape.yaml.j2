apiVersion: cilium.io/v2
kind: CiliumClusterwideNetworkPolicy
metadata:
  name: allow-prometheus-scrape
spec:
  description: "Tum pod'lara gelen scrape trafigini Prometheus'a (monitoring ns) acar"
  endpointSelector: {}
  ingress:
  - fromEndpoints:
    - matchLabels:
        k8s:io.kubernetes.pod.namespace: monitoring
    toPorts:
    - ports:
      - port: "9090"
        protocol: TCP
      - port: "8080"
        protocol: TCP
      - port: "9093"
        protocol: TCP
      - port: "9100"
        protocol: TCP
      - port: "9113"
        protocol: TCP
      - port: "9153"
        protocol: TCP
      - port: "10250"
        protocol: TCP
      - port: "3000"
        protocol: TCP
