# OpenBao Configuration
# Managed by Ansible - {{ ansible_managed }}

storage "{{ openbao_storage_type }}" {
  path    = "{{ openbao_raft_path }}"
  node_id = "{{ inventory_hostname }}"
}

listener "tcp" {
  address       = "0.0.0.0:{{ openbao_port }}"
  tls_disable   = false
  tls_cert_file = "{{ openbao_tls_cert }}"
  tls_key_file  = "{{ openbao_tls_key }}"
}

api_addr     = "{{ openbao_api_addr }}"
cluster_addr = "{{ openbao_cluster_addr }}"
ui = {{ "true" if openbao_ui_enabled else "false" }}

# Red Team hardening
default_lease_ttl = "24h"
max_lease_ttl     = "720h"
{% if openbao.telemetry.enabled | default(false) | bool %}

# Telemetry — Prometheus /sys/metrics endpoint'i icin gerekli
telemetry {
  prometheus_retention_time = "{{ openbao.telemetry.prometheus_retention_time | default('30s') }}"
  disable_hostname = {{ openbao.telemetry.disable_hostname | default(true) | lower }}
}
{% endif %}

# Audit logging
audit "file" "audit-log" {
  description = "OpenBao audit log"
  options {
    file_path = "/var/log/bao/audit.log"
    log_raw   = "false"
  }
}
