#!/usr/bin/env bash
{{ '#' }} check-repos.sh — weekly integrity verification of the host's restic repos
{{ '#' }} (restic check: MAC + pack integrity — the cryptographic version of the "size >= 1MB" heuristic)
{{ '#' }} Generated by: roles/maintenance — do not edit by hand.
{{ '#' }}
{{ '#' }} Secret source: <job>.secrets.conf -> systemd-creds decrypt. The same
{{ '#' }} pattern is used in restic-repo.yml and restore/_common.sh (DRY §7).
{{ '#' }} LoadCredentialEncrypted only works inside systemd services; even though
{{ '#' }} this script runs in check.service it sources the .env files in a LOOP,
{{ '#' }} so it has to resolve the credential once per job.
{{ '#' }} The sub-shell ( ... ) is mandatory: each job's secrets must not LEAK into
{{ '#' }} the next one (otherwise later jobs would be checked with the last .env's secrets).

set -u
d="{{ m_conf }}/backup"
rc=0

shopt -s nullglob
for f in "$d"/*.env; do
    job="$(basename "$f" .env)"
    if ! (
        set -a
        # shellcheck disable=SC1090
        . "$f"
        set +a
        if ! command -v systemd-creds >/dev/null 2>&1; then
            echo "[FAIL] $job — systemd-creds not found (systemd < 250?)" >&2
            exit 1
        fi
        conf="$d/$job.secrets.conf"
        if [ ! -f "$conf" ]; then
            echo "[FAIL] $job — no encrypted credential: $conf" >&2
            exit 1
        fi
        # --name is mandatory: the file name is "<job>.secrets.conf" while the
        # embedded name is "<job>-secrets" — systemd-creds compares the two and
        # rejects the file. Encrypt side: encrypt-creds.yml --name=<job>-secrets
        out="$(systemd-creds decrypt --name="${job}-secrets" "$conf")" || {
            echo "[FAIL] $job — credential could not be decrypted (see the systemd-creds message above)" >&2
            exit 1
        }
        set -a
        # shellcheck disable=SC1090
        . /dev/stdin <<< "$out"
        set +a
        unset out conf
        echo "[check] $job -> ${RESTIC_REPOSITORY:-?}"
        timeout -k 10 {{ restic_timeout_sec }} {{ restic_bin }} check
    ); then
        echo "[FAIL] $job"
        rc=1
    fi
done
exit "$rc"
